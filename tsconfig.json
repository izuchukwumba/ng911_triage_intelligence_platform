{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@ng911/incident-schema": ["./packages/incident-schema/src/index.ts"],
      "@ng911/location-validator": ["./packages/location-validator/src/index.ts"],
      "@ng911/transcript-parser": ["./services/transcript-parser/src/index.ts"],
      "@ng911/prioritization-engine": ["./services/prioritization-engine/src/index.ts"],
      "@ng911/test-data-generator": ["./packages/test-data-generator/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "services/*/src/**/*"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
