{
  "$defs": {
    "AdvisoryPriority": {
      "description": "Project-defined research labels, not PSAP or dispatch-protocol codes.",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "title": "AdvisoryPriority",
      "type": "string"
    },
    "ReplayCase": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReplayOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_lowers_priority": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Lowers Priority"
        },
        "incident_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Incident Id",
          "type": "string"
        },
        "priority_changed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Priority Changed"
        },
        "reproduced": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReplayOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "reproducible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reproducible"
        },
        "skipped_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped Reason"
        },
        "stored": {
          "$ref": "#/$defs/ReplayOutcome"
        },
        "stored_assessment_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Stored Assessment Id",
          "type": "string"
        }
      },
      "required": [
        "incident_id",
        "stored_assessment_id",
        "stored",
        "reproduced",
        "reproducible",
        "candidate",
        "priority_changed",
        "candidate_lowers_priority"
      ],
      "title": "ReplayCase",
      "type": "object"
    },
    "ReplayOutcome": {
      "additionalProperties": false,
      "description": "What one ruleset produced for one incident.",
      "properties": {
        "advisory_priority": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdvisoryPriority"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "ruleset_version": {
          "title": "Ruleset Version",
          "type": "string"
        },
        "severity_band": {
          "$ref": "#/$defs/SeverityBand"
        }
      },
      "required": [
        "ruleset_version",
        "severity_band",
        "advisory_priority",
        "reason_codes"
      ],
      "title": "ReplayOutcome",
      "type": "object"
    },
    "ReplaySummary": {
      "additionalProperties": false,
      "properties": {
        "candidate_lowers_priority": {
          "title": "Candidate Lowers Priority",
          "type": "integer"
        },
        "incidents": {
          "title": "Incidents",
          "type": "integer"
        },
        "not_reproducible": {
          "title": "Not Reproducible",
          "type": "integer"
        },
        "priority_changed": {
          "title": "Priority Changed",
          "type": "integer"
        },
        "reproducible": {
          "title": "Reproducible",
          "type": "integer"
        },
        "skipped": {
          "title": "Skipped",
          "type": "integer"
        }
      },
      "required": [
        "incidents",
        "skipped",
        "reproducible",
        "not_reproducible",
        "priority_changed",
        "candidate_lowers_priority"
      ],
      "title": "ReplaySummary",
      "type": "object"
    },
    "SeverityBand": {
      "enum": [
        "critical",
        "high",
        "elevated",
        "standard",
        "low",
        "undetermined"
      ],
      "title": "SeverityBand",
      "type": "string"
    }
  },
  "$id": "https://ntip.local/schemas/v2.1.0/replay-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_ruleset": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Candidate Ruleset"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/ReplayCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "note": {
      "default": "Replay never modifies stored incidents or assessments. Differences are illustrative and are not validated improvements.",
      "title": "Note",
      "type": "string"
    },
    "requested_by": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Requested By",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/ReplaySummary"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "requested_by",
    "candidate_ruleset",
    "engine_version",
    "cases",
    "summary"
  ],
  "title": "ReplayRun",
  "type": "object",
  "x-schema-version": "2.1.0"
}
