{
  "$defs": {
    "SourceType": {
      "enum": [
        "synthetic_transcript",
        "structured_test_event"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "$id": "https://ntip.local/schemas/v2.1.0/source-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "incident_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Incident Id",
      "type": "string"
    },
    "payload_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Payload Digest",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "schema_version": {
      "default": "2.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_event_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Source Event Id",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "supersedes": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "text": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "source_event_id",
    "incident_id",
    "received_at",
    "source_type",
    "text",
    "synthetic",
    "payload_digest"
  ],
  "title": "SourceEvent",
  "type": "object",
  "x-schema-version": "2.1.0"
}
