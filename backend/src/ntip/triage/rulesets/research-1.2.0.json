      "all_of": [
        "SELF_HARM_RISK"
      ],
      "severity": "high",
      "reason_code": "SELF_HARM_RISK_REPORTED"
    },
    {
      "id": "R-INTR-001",
      "version": "1.0.0",
      "description": "Caller reports an intruder in the home now",
      "all_of": [
        "INTRUDER_PRESENT"
      ],
      "severity": "high",
      "reason_code": "INTRUDER_PRESENT_REPORTED"
    },
    {
      "id": "R-TRAF-001",
      "version": "1.0.0",
      "description": "Caller reports a traffic collision",
      "all_of": [
        "TRAFFIC_COLLISION"
      ],
      "severity": "elevated",
      "reason_code": "TRAFFIC_COLLISION_REPORTED"
    },
    {
      "id": "R-MISS-001",
      "version": "1.0.0",
      "description": "Caller reports a missing person",
      "all_of": [
        "MISSING_PERSON"
      ],
      "severity": "elevated",
      "reason_code": "MISSING_PERSON_REPORTED"
    },
    {
      "id": "R-FIRE-001",
      "version": "1.0.0",
      "description": "Fire reported",
      "all_of": [
        "FIRE_REPORTED"
      ],
      "severity": "elevated",
      "reason_code": "FIRE_REPORTED"
    },
    {
      "id": "R-FIRE-005",
      "version": "1.0.0",
      "description": "Smoke reported",
      "all_of": [
        "SMOKE_REPORTED"
      ],
      "severity": "elevated",
      "reason_code": "SMOKE_REPORTED"
    },
    {
      "id": "R-INJ-001",
      "version": "1.0.0",
      "description": "Injury reported",
      "all_of": [
        "INJURY_REPORTED"
      ],
      "severity": "standard",
      "reason_code": "INJURY_REPORTED"
    },
    {
      "id": "R-SCALE-001",
      "version": "1.0.0",
      "description": "Multiple victims reported: one band more severe",
      "all_of": [
        "MULTIPLE_VICTIMS"
      ],
      "severity": "elevated",
      "effect": "escalate",
      "reason_code": "MULTIPLE_VICTIMS_REPORTED"
    },
    {
      "id": "R-VULN-001",
      "version": "1.0.0",
      "description": "Child involved: one band more severe",
      "all_of": [
        "CHILD_INVOLVED"
      ],
      "severity": "standard",
      "effect": "escalate",
      "reason_code": "CHILD_INVOLVED"
    },
    {
      "id": "R-MOB-001",
      "version": "1.0.0",
      "description": "Person reported unable to get up",
      "all_of": [
        "UNABLE_TO_GET_UP"
      ],
      "severity": "elevated",
      "reason_code": "UNABLE_TO_GET_UP"
    },
    {
      "id": "R-HIST-001",
      "version": "1.0.0",
      "description": "Breathing or pulse reported to have stopped earlier",
      "all_of": [
        "NOT_BREATHING"
      ],
      "severity": "elevated",
      "temporality": "historical",
      "reason_code": "RECENT_NOT_BREATHING"
    },
    {
      "id": "R-HIST-002",
      "version": "1.0.0",
      "description": "Person reported to have been unconscious earlier",
      "all_of": [
        "UNCONSCIOUS"
      ],
      "severity": "elevated",
      "temporality": "historical",
      "reason_code": "RECENT_UNCONSCIOUSNESS"
    }
  ]
}
