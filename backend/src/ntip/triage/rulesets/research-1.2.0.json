      "all_of": [
        "ELECTROCUTION"
      ],
      "severity": "high",
      "reason_code": "ELECTROCUTION_REPORTED"
    },
    {
      "id": "R-FALL-001",
      "version": "1.0.0",
      "description": "Caller reports a fall from a height (roof, ladder, balcony, window, stairs)",
      "all_of": [
        "FALL_FROM_HEIGHT"
      ],
      "severity": "high",
      "reason_code": "FALL_FROM_HEIGHT_REPORTED"
    },
    {
      "id": "R-PSY-001",
      "version": "1.0.0",
