        "ALLERGIC_REACTION"
      ],
      "severity": "high",
      "reason_code": "ALLERGIC_REACTION_REPORTED"
    },
    {
      "id": "R-METAB-001",
      "version": "1.0.0",
      "description": "Caller reports a diabetic emergency (very low or high blood sugar)",
      "all_of": [
        "DIABETIC_EMERGENCY"
      ],
      "severity": "high",
      "reason_code": "DIABETIC_EMERGENCY_REPORTED"
    },
    {
      "id": "R-OB-001",
      "version": "1.0.0",
      "description": "Caller reports labour or a birth in progress",
      "all_of": [
        "CHILDBIRTH"
      ],
      "severity": "high",
      "reason_code": "CHILDBIRTH_REPORTED"
    },
    {
      "id": "R-TOX-002",
      "version": "1.0.0",
      "description": "Caller reports a poisoning (a harmful substance swallowed, not a drug overdose)",
      "all_of": [
        "POISONING"
      ],
      "severity": "high",
      "reason_code": "POISONING_REPORTED"
    },
    {
      "id": "R-ENV-001",
      "version": "1.0.0",
      "description": "Caller reports a drowning or a person pulled from water",
      "all_of": [
        "DROWNING"
      ],
      "severity": "high",
      "reason_code": "DROWNING_REPORTED"
    },
    {
      "id": "R-BURN-001",
      "version": "1.0.0",
      "description": "Caller reports a burn or scald injury",
