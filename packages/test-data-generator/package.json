{
  "name": "@ng911/test-data-generator",
  "version": "0.1.0",
  "description": "Generates synthetic emergency scenarios for testing, simulation, and evaluation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ng911-generate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
