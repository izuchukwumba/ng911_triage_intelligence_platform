    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ng911/incident-schema": "*"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
